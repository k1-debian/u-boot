property:
    disk_size = 3728m
    gpt_header_lba = 512
    custom_signature = 0

partition:
	#name     =  start,   size, fstype
	xboot     =     0m,     1m,
	kernel    =     1m,     8m, EMPTY
	rootfs    =     9m,    100m, LINUX_FS
	userdata  =   109m,    3619m, LINUX_FS

#fstype could be: LINUX_FS, FAT_FS, EMPTY
